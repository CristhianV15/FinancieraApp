@page
@model FinancieraApp.Web.Pages.Bancos.CreateModel

@{
    ViewData["Title"] = "Nuevo banco";
}

<h1>Nuevo banco</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Banco.Nombre" class="form-label"></label>
        <input asp-for="Banco.Nombre" class="form-control" />
        <span asp-validation-for="Banco.Nombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}